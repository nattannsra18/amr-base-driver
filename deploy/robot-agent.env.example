# Install as /etc/indoor-delivery-robot/agent.env with mode 0600.
ROBOT_CONTROL_URL=wss://control.example.com
ROBOT_WORKSPACE=/opt/indoor-delivery-robot/ros
ROBOT_PROFILE_FILE=/etc/indoor-delivery-robot/robot-agent.yaml
ROBOT_CREDENTIAL_FILE=/var/lib/indoor-delivery-robot/agent-credential.json

# Enrollment-only bootstrap secret. It cannot open an operational robot socket.
# Remove it after pairing when re-enrollment from this robot is not required.
ROBOT_ENROLLMENT_TOKEN=replace-with-limited-bootstrap-secret

ROS_DISTRO=jazzy
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ROS_DOMAIN_ID=0
