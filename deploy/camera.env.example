# Stable V4L2 by-id capture endpoint. Do not use /dev/videoN here.
CAMERA_DEVICE=/dev/v4l/by-id/usb-Generic_USB_Camera_200901010001-video-index0

# Bind only to loopback. The separate relay opens the outbound WSS connection.
CAMERA_HOST=127.0.0.1
CAMERA_PORT=8081

# Keep frame cadence stable for teleoperation. Set to 1 only if low-light
# exposure is more important than live video latency.
CAMERA_DYNAMIC_FRAMERATE=0
