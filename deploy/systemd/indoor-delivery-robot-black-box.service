[Unit]
Description=Indoor Delivery Robot Rolling Incident Recorder
Documentation=https://github.com/nattannsra18/amr-base-driver
After=indoor-delivery-robot-base.service
Wants=indoor-delivery-robot-base.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
Slice=indoor-delivery-robot-background.slice
User=odroid
Group=odroid
WorkingDirectory=/home/odroid/amr_ws
EnvironmentFile=/etc/indoor-delivery-robot/navigation.env
ExecStart=/usr/bin/bash -lc 'source "/opt/ros/$ROS_DISTRO/setup.bash" && source "$AMR_WORKSPACE/install/setup.bash" && exec ros2 run amr_base_driver black_box_recorder --ros-args -p retention_seconds:=300.0 -p max_topic_hz:=1.0 -p record_scan:=false -p record_tf:=false -p record_extended_navigation:=false'
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
KillSignal=SIGINT
Nice=10
CPUWeight=10
AllowedCPUs=0-2

[Install]
WantedBy=multi-user.target
