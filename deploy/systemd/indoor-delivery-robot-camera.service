[Unit]
Description=Indoor Delivery Robot MJPEG Camera Stream
Documentation=https://github.com/nattannsra18/amr-base-driver
After=network-online.target tailscaled.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=odroid
Group=odroid
SupplementaryGroups=video
EnvironmentFile=/etc/indoor-delivery-robot/camera.env
ExecStartPre=/usr/bin/test -e ${CAMERA_DEVICE}
ExecStart=/usr/bin/ustreamer --device=${CAMERA_DEVICE} --format=MJPEG --encoder=HW --resolution=640x480 --desired-fps=30 --host=${CAMERA_HOST} --port=${CAMERA_PORT} --buffers=1 --workers=1 --tcp-nodelay --persistent --device-error-delay=2 --no-log-colors
Restart=always
RestartSec=3
TimeoutStopSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
MemoryMax=96M
CPUQuota=25%
Nice=10

[Install]
WantedBy=multi-user.target
